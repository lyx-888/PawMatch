# Copy to .env and fill in real values. .env is gitignored.

# --- Supabase ---
# Same project as web/. URL is public; SERVICE_ROLE is secret (bypasses RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Phase 2+) ---
# Used by gpt-4o-mini to extract structured fields from shelter pet bios.
OPENAI_API_KEY=

# --- Feature flags ---
# Set to true to bypass LLM extraction; pets land in Postgres with raw fields only.
LLM_DISABLED=false
