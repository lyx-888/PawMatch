# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# --- Supabase ---
# Find these at: Supabase Dashboard → Project Settings → API Keys
# Project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Browser-safe when RLS is on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (Phase 2+) ---
# https://platform.openai.com/api-keys — used by scrapers for gpt-4o-mini extraction.
# Set a $20/mo usage limit on the key.
OPENAI_API_KEY=

# --- Inngest (Phase 3+) ---
# Background jobs: match recompute, notifications, daily picks.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (Phase 3+) ---
# Transactional email.
RESEND_API_KEY=

# --- Web Push (Phase 3+) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email for push subscriber identification (mailto:).
VAPID_SUBJECT=mailto:contact@example.com

# --- Sentry (Phase 0.7) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Analytics (Phase 0.8) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Feature flags / kill switches ---
# Set to true to bypass LLM extraction (pets serve with raw fields only).
LLM_DISABLED=false
# Set to true to put the entire app into maintenance mode.
MAINTENANCE_MODE=false
